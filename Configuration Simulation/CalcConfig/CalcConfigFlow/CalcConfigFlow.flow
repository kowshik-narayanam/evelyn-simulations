  "name": "CalcConfigFlow",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "78d97bdf-8058-43d4-b03c-cfe4012db918",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "loadConfiguration1",
      "type": "uipath.core.function.1fc79131-bcf8-4874-835a-568c0fd01095",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Load configuration"
      },
      "inputs": {
        "operation": "load_configuration",
        "overrides": "=js:$vars.start.output.overrides",
        "config_path": "config/configuration_payload.json",
        "config": null,
        "numbers": null,
        "results": null,
        "report_path": ""
      }
    },
    {
      "id": "readNumbers1",
      "type": "uipath.core.function.1fc79131-bcf8-4874-835a-568c0fd01095",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Read numbers"
      },
      "inputs": {
        "operation": "read_numbers",
        "overrides": null,
        "config_path": "",
        "config": "=js:$vars.loadConfiguration1.output.config",
        "numbers": "=js:$vars.start.output.numbers",
        "results": null,
        "report_path": ""
      }
    },
    {
      "id": "whichCalculator1",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Which calculator?"
      },
      "inputs": {
        "cases": [
          {
            "id": "add",
            "label": "ADD",
            "expression": "$vars.loadConfiguration1.output.provider_id === \"ADD\""
          },
          {
            "id": "subtract",
            "label": "SUBTRACT",
            "expression": "$vars.loadConfiguration1.output.provider_id === \"SUBTRACT\""
          },
          {
            "id": "multiply",
            "label": "MULTIPLY",
            "expression": "$vars.loadConfiguration1.output.provider_id === \"MULTIPLY\""
          },
          {
            "id": "divide",
            "label": "DIVIDE",
            "expression": "$vars.loadConfiguration1.output.provider_id === \"DIVIDE\""
          }
        ]
      }
    },
    {
      "id": "add1",
      "type": "uipath.core.function.1fc79131-bcf8-4874-835a-568c0fd01095",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Add"
      },
      "inputs": {
        "operation": "add",
        "overrides": null,
        "config_path": "",
        "config": "=js:$vars.loadConfiguration1.output.config",
        "numbers": "=js:$vars.readNumbers1.output.numbers",
        "results": null,
        "report_path": ""
      }
    },
    {
      "id": "subtract1",
      "type": "uipath.core.function.1fc79131-bcf8-4874-835a-568c0fd01095",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Subtract"
      },
      "inputs": {
        "operation": "subtract",
        "overrides": null,
        "config_path": "",
        "config": "=js:$vars.loadConfiguration1.output.config",
        "numbers": "=js:$vars.readNumbers1.output.numbers",
        "results": null,
        "report_path": ""
      }
    },
    {
      "id": "multiply1",
      "type": "uipath.core.function.1fc79131-bcf8-4874-835a-568c0fd01095",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Multiply"
      },
      "inputs": {
        "operation": "multiply",
        "overrides": null,
        "config_path": "",
        "config": "=js:$vars.loadConfiguration1.output.config",
        "numbers": "=js:$vars.readNumbers1.output.numbers",
        "results": null,
        "report_path": ""
      }
    },
    {
      "id": "divide1",
      "type": "uipath.core.function.1fc79131-bcf8-4874-835a-568c0fd01095",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Divide"
      },
      "inputs": {
        "operation": "divide",
        "overrides": null,
        "config_path": "",
        "config": "=js:$vars.loadConfiguration1.output.config",
        "numbers": "=js:$vars.readNumbers1.output.numbers",
        "results": null,
        "report_path": ""
      }
    },
    {
      "id": "csvReportOn1",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "CSV report on?"
      },
      "inputs": {
        "trueLabel": "Write it",
        "falseLabel": "Skip it",
        "expression": "$vars.loadConfiguration1.output.report_enabled"
      }
    },
    {
      "id": "writeReport1",
      "type": "uipath.core.function.1fc79131-bcf8-4874-835a-568c0fd01095",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Write report"
      },
      "inputs": {
        "operation": "write_report",
        "overrides": null,
        "config_path": "",
        "config": null,
        "numbers": null,
        "results": "=js:$vars.calculation.results",
        "report_path": "=js:$vars.loadConfiguration1.output.report_path"
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End"
      },
      "inputs": {},
      "outputs": {
        "calculation": {
          "source": "=js:$vars.calculation",
          "type": "object"
        },
        "provider_id": {
          "source": "=js:$vars.calculation.provider_id",
          "type": "string"
        },
        "alert_count": {
          "source": "=js:$vars.calculation.alert_count",
          "type": "number"
        },
        "report_path": {
          "source": "=js:$vars.loadConfiguration1.output.report_path",
          "type": "string"
        },
        "overridden_keys": {
          "source": "=js:$vars.loadConfiguration1.output.overridden_keys",
          "type": "array"
        }
      }
    }
